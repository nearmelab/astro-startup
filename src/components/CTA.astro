---
const { t, lang } = Astro.props;
---
<section id="contact" class="bg-light-card dark:bg-dark-card border-t border-light-border dark:border-dark-border">
    <div class="container mx-auto px-6 py-20">
      <div class="bg-primary/10 dark:bg-primary/20 p-10 rounded-lg text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-dark-text dark:text-light-text">
            {t('cta.title')}
          </h2>
          <p class="mt-4 text-lg text-medium-text-light dark:text-medium-text max-w-2xl mx-auto">
            {t('cta.subtitle')}
          </p>
          <div class="mt-8">
            <a
              href={`/${lang}/contact`}
              class="bg-primary text-white px-10 py-4 rounded-md font-bold text-lg hover:bg-primary-hover transition-all duration-300 shadow-lg shadow-primary/20"
            >
              {t('cta.button')}
            </a>
          </div>
      </div>
    </div>
</section>
