---
import ClientTabs from './ClientTabs.jsx';
import { getLangFromUrl } from '../i18n/utils';

export interface Props {
    t: (key: string) => any;
}

const { t } = Astro.props as Props;

const lang = getLangFromUrl(Astro.url);
const isRTL = lang === 'ar';

// ✅ Get translations on the server and pass as props
const ctaText = t('client_results.cta_button');
---

<section class="py-16 sm:py-20" dir={isRTL ? 'rtl' : 'ltr'}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-5xl font-bold tracking-tight text-gray-900 sm:text-6xl dark:text-white">
        {t('client_results.title')}
      </h2>
    </div>
    <div class="mt-20">
      <ClientTabs client:visible lang={lang} ctaText={ctaText} />
    </div>
  </div>
</section>