---
const { t, lang } = Astro.props;
--- 
<section class="py-20">
  <div class="container mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-800 dark:text-white">{t('portfolio.title')}</h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">{t('portfolio.description')}</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden">
        <div class="h-64 bg-gray-200 dark:bg-gray-700 animate-pulse"></div>
        <div class="p-6">
          <div class="h-6 w-3/4 bg-gray-300 dark:bg-gray-600 rounded mb-4 animate-pulse"></div>
          <div class="h-4 w-1/2 bg-gray-300 dark:bg-gray-600 rounded animate-pulse"></div>
        </div>
      </div>
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden">
        <div class="h-64 bg-gray-200 dark:bg-gray-700 animate-pulse"></div>
        <div class="p-6">
          <div class="h-6 w-3/4 bg-gray-300 dark:bg-gray-600 rounded mb-4 animate-pulse"></div>
          <div class="h-4 w-1/2 bg-gray-300 dark:bg-gray-600 rounded animate-pulse"></div>
        </div>
      </div>
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden">
        <div class="h-64 bg-gray-200 dark:bg-gray-700 animate-pulse"></div>
        <div class="p-6">
          <div class="h-6 w-3/4 bg-gray-300 dark:bg-gray-600 rounded mb-4 animate-pulse"></div>
          <div class="h-4 w-1/2 bg-ray-300 dark:bg-gray-600 rounded animate-pulse"></div>
        </div>
      </div>
    </div>
  </div>
</section>
