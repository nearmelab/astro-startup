---
export interface Props {
  t: (key: string) => any;
}

const { t } = Astro.props;
---

<section id="services" class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-center mb-12">{t('services.title')}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            
            <div class="bg-white/10 p-8 rounded-lg shadow-lg text-center">
                <h3 class="text-2xl font-bold mb-4">{t('services.web_development.title')}</h3>
                <p>{t('services.web_development.description')}</p>
            </div>

            <div class="bg-white/10 p-8 rounded-lg shadow-lg text-center">
                <h3 class="text-2xl font-bold mb-4">{t('services.mobile_development.title')}</h3>
                <p>{t('services.mobile_development.description')}</p>
            </div>

            <div class="bg-white/10 p-8 rounded-lg shadow-lg text-center">
                <h3 class="text-2xl font-bold mb-4">{t('services.ui_ux_design.title')}</h3>
                <p>{t('services.ui_ux_design.description')}</p>
            </div>

        </div>
    </div>
</section>
