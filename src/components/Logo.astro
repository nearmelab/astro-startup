<a href="/" class="flex items-center">
  <!-- Light Mode Logo -->
  <img 
    src="/logos/svg/header-logo-transparent-light.svg" 
    alt="NearMeLab Logo Light"
    width="200"
    height="60"
    class="dark:hidden h-10 w-auto"
