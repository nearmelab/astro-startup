---
export interface Props {
    t: (key: string) => any;
}

const { t } = Astro.props;
---

<section id="contact" class="py-20 bg-base-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-center mb-12">{t('contact.title')}</h2>
        <div class="max-w-lg mx-auto">
            <form action="#" method="POST" class="grid grid-cols-1 gap-y-6">
                <div>
                    <label for="full-name" class="sr-only">{t('contact.full_name')}</label>
                    <input type="text" name="full-name" id="full-name" autocomplete="name" class="input input-bordered w-full" placeholder={t('contact.full_name')}>
                </div>
                <div>
                    <label for="email" class="sr-only">{t('contact.email')}</label>
                    <input type="email" name="email" id="email" autocomplete="email" class="input input-bordered w-full" placeholder={t('contact.email')}>
                </div>
                <div>
                    <label for="message" class="sr-only">{t('contact.message')}</label>
                    <textarea name="message" id="message" rows="4" class="textarea textarea-bordered w-full" placeholder={t('contact.message')}></textarea>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary w-full">{t('contact.submit')}</button>
                </div>
            </form>
        </div>
    </div>
</section>
