---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { useTranslations } from '@/i18n/utils';
import { ui } from '@/i18n/ui';
import IconExtension from '~icons/tabler/terminal';
import IconTerminal from '~icons/tabler/terminal';
import IconSpeed from '~icons/tabler/rocket';
import IconDatabase from '~icons/tabler/database';
import IconShield from '~icons/tabler/shield';
import IconBrowser from '~icons/tabler/browser';
import IconWorld from '~icons/tabler/world';
import IconShoppingCart from '~icons/tabler/shopping-cart';
import IconTrendingUp from '~icons/tabler/trending-up';

export function getStaticPaths() {
  return Object.keys(ui).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const t = useTranslations(lang);
const isRTL = lang === 'ar';
---

<DefaultLayout
    title={t('services.title')}
    description={t('services.description')}
    dir={isRTL ? 'rtl' : 'ltr'}
>
  <main class="pt-32 pb-24">
    <!-- Hero Section -->
    <section class="px-4 sm:px-6 lg:px-8 mb-24">
      <div class="max-w-4xl mx-auto text-center">
        <span class="font-bold uppercase tracking-widest text-primary mb-6 block text-sm">
          {t('services.eyebrow')}
        </span>
        <h1 class="text-4xl md:text-6xl font-extrabold mb-8 text-slate-900 dark:text-white leading-tight">
          {t('services.title')}
          <br />
          <span class="text-primary bg-gradient-to-r from-primary to-cyan-400 bg-clip-text text-transparent">
            {t('services.subtitle')}
          </span>
        </h1>
        <p class="text-lg md:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
          {t('services.description')}
        </p>
      </div>
    </section>

    <!-- Expertise Grid (Icon-based) -->
    <section class="px-4 sm:px-6 lg:px-8 mb-24">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-px bg-slate-200 dark:bg-slate-700 border border-slate-200 dark:border-slate-700">
        <div class="bg-white dark:bg-slate-900 p-8 flex flex-col items-center justify-center hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors group">
          <IconExtension class="w-10 h-10 mb-4 text-slate-400 group-hover:text-cyan-500 transition-colors" />
          <span class="text-xs font-bold uppercase text-slate-600 dark:text-slate-400 group-hover:text-slate-900 dark:group-hover:text-white">
            {t('services.expertise.addons')}
          </span>
        </div>
        <div class="bg-white dark:bg-slate-900 p-8 flex flex-col items-center justify-center hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors group">
          <IconTerminal class="w-10 h-10 mb-4 text-slate-400 group-hover:text-purple-500 transition-colors" />
          <span class="text-xs font-bold uppercase text-slate-600 dark:text-slate-400 group-hover:text-slate-900 dark:group-hover:text-white">
            {t('services.expertise.backend')}
          </span>
        </div>
        <div class="bg-white dark:bg-slate-900 p-8 flex flex-col items-center justify-center hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors group">
          <IconSpeed class="w-10 h-10 mb-4 text-slate-400 group-hover:text-primary transition-colors" />
          <span class="text-xs font-bold uppercase text-slate-600 dark:text-slate-400 group-hover:text-slate-900 dark:group-hover:text-white">
            {t('services.expertise.vitals')}
          </span>
        </div>
        <div class="bg-white dark:bg-slate-900 p-8 flex flex-col items-center justify-center hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors group">
          <IconDatabase class="w-10 h-10 mb-4 text-slate-400 group-hover:text-cyan-500 transition-colors" />
          <span class="text-xs font-bold uppercase text-slate-600 dark:text-slate-400 group-hover:text-slate-900 dark:group-hover:text-white">
            {t('services.expertise.architecture')}
          </span>
        </div>
        <div class="bg-white dark:bg-slate-900 p-8 flex flex-col items-center justify-center hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors group">
          <IconShield class="w-10 h-10 mb-4 text-slate-400 group-hover:text-primary transition-colors" />
          <span class="text-xs font-bold uppercase text-slate-600 dark:text-slate-400 group-hover:text-slate-900 dark:group-hover:text-white">
            {t('services.expertise.privacy')}
          </span>
        </div>
      </div>
    </section>

    <!-- Detailed Services Breakdown -->
    <section class="px-4 sm:px-6 lg:px-8 space-y-8">
      <!-- Service Row 1: Browser Extensions -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <div class="md:col-span-7 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 p-8 lg:p-10 flex flex-col justify-between group hover:border-cyan-500 transition-all duration-300 shadow-sm hover:shadow-md">
          <div>
            <div class={isRTL ? 'flex justify-between items-start mb-8 flex-row-reverse' : 'flex justify-between items-start mb-8'}>
              <span class="text-xs font-bold text-cyan-500 border border-cyan-500 px-3 py-1">01 / {t('services.badge.core')}</span>
              <IconBrowser class="w-10 h-10 text-cyan-500" />
            </div>
            <h2 class="text-3xl md:text-4xl font-bold mb-4 text-slate-900 dark:text-white">
              {t('services.browser_extensions.title')}
            </h2>
            <p class="text-lg text-slate-600 dark:text-slate-400 mb-8 max-w-lg">
              {t('services.browser_extensions.description')}
            </p>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-6 font-mono text-sm text-slate-600 dark:text-slate-400 overflow-hidden">
            <div class="flex items-center gap-2 mb-2 text-cyan-500 font-bold">
              <span class="w-2 h-2 bg-cyan-500 rounded-full"></span> manifest.json
            </div>
            <code class="text-xs">{`{ "permissions": ["storage", "tabs"], "action": { "default_popup": "index.html" } }`}</code>
          </div>
        </div>
        <div class="md:col-span-5 relative overflow-hidden h-[400px] md:h-auto border border-slate-200 dark:border-slate-700">
          <img 
            class="w-full h-full object-cover" 
            src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=800&h=600&fit=crop" 
            alt={t('services.browser_extensions.image_alt')}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-white/80 dark:from-slate-900/80 to-transparent"></div>
          <div class={isRTL ? 'absolute bottom-6 right-6 text-right' : 'absolute bottom-6 right-6 text-right'}>
            <div class="text-cyan-500 text-3xl md:text-4xl font-black">99.9%</div>
            <div class="text-xs font-bold uppercase text-slate-600 dark:text-slate-400">{t('services.browser_extensions.satisfaction')}</div>
          </div>
        </div>
      </div>

      <!-- Service Row 2: Web Solutions -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <div class="md:col-span-5 h-[400px] md:h-auto border border-slate-200 dark:border-slate-700 overflow-hidden">
          <img 
            class="w-full h-full object-cover" 
            src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=800&h=600&fit=crop" 
            alt={t('services.web_solutions.image_alt')}
          />
        </div>
        <div class="md:col-span-7 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 p-8 lg:p-10 flex flex-col justify-between group hover:border-purple-500 transition-all duration-300 shadow-sm hover:shadow-md">
          <div>
            <div class={isRTL ? 'flex justify-between items-start mb-8 flex-row-reverse' : 'flex justify-between items-start mb-8'}>
              <span class="text-xs font-bold text-purple-500 border border-purple-500 px-3 py-1">02 / {t('services.badge.web')}</span>
              <IconWorld class="w-10 h-10 text-purple-500" />
            </div>
            <h2 class="text-3xl md:text-4xl font-bold mb-4 text-slate-900 dark:text-white">
              {t('services.web_solutions.title')}
            </h2>
            <p class="text-lg text-slate-600 dark:text-slate-400 mb-8 max-w-lg">
              {t('services.web_solutions.description')}
            </p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="border border-slate-200 dark:border-slate-700 p-6 hover:bg-purple-50 dark:hover:bg-purple-900/10 transition-colors">
              <div class="text-purple-500 text-2xl md:text-3xl font-bold mb-2">&lt;200ms</div>
              <div class="text-xs font-bold uppercase text-slate-600 dark:text-slate-400">{t('services.web_solutions.response_time')}</div>
            </div>
            <div class="border border-slate-200 dark:border-slate-700 p-6 hover:bg-purple-50 dark:hover:bg-purple-900/10 transition-colors">
              <div class="text-purple-500 text-2xl md:text-3xl font-bold mb-2">100</div>
              <div class="text-xs font-bold uppercase text-slate-600 dark:text-slate-400">{t('services.web_solutions.lighthouse')}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Service Row 3: Growth & Commerce -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 p-8 lg:p-10 group hover:border-primary transition-all duration-300 shadow-sm hover:shadow-md">
          <div class={isRTL ? 'flex justify-between items-start mb-8 flex-row-reverse' : 'flex justify-between items-start mb-8'}>
            <span class="text-xs font-bold text-primary border border-primary px-3 py-1">03 / {t('services.badge.business')}</span>
            <IconTrendingUp class="w-10 h-10 text-primary" />
          </div>
          <h3 class="text-2xl font-bold mb-4 text-slate-900 dark:text-white">
            {t('services.business.title')}
          </h3>
          <p class="text-base text-slate-600 dark:text-slate-400 mb-6">
            {t('services.business.description')}
          </p>
          <ul class="space-y-3 font-mono text-sm text-slate-600 dark:text-slate-400">
            <li class="flex items-center gap-2"><span class="text-primary">●</span> {t('services.business.feature1')}</li>
            <li class="flex items-center gap-2"><span class="text-primary">●</span> {t('services.business.feature2')}</li>
            <li class="flex items-center gap-2"><span class="text-primary">●</span> {t('services.business.feature3')}</li>
          </ul>
        </div>
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 p-8 lg:p-10 group hover:border-cyan-500 transition-all duration-300 shadow-sm hover:shadow-md">
          <div class={isRTL ? 'flex justify-between items-start mb-8 flex-row-reverse' : 'flex justify-between items-start mb-8'}>
            <span class="text-xs font-bold text-cyan-500 border border-cyan-500 px-3 py-1">04 / {t('services.badge.commerce')}</span>
            <IconShoppingCart class="w-10 h-10 text-cyan-500" />
          </div>
          <h3 class="text-2xl font-bold mb-4 text-slate-900 dark:text-white">
            {t('services.commerce.title')}
          </h3>
          <p class="text-base text-slate-600 dark:text-slate-400 mb-6">
            {t('services.commerce.description')}
          </p>
          <ul class="space-y-3 font-mono text-sm text-slate-600 dark:text-slate-400">
            <li class="flex items-center gap-2"><span class="text-cyan-500">●</span> {t('services.commerce.feature1')}</li>
            <li class="flex items-center gap-2"><span class="text-cyan-500">●</span> {t('services.commerce.feature2')}</li>
            <li class="flex items-center gap-2"><span class="text-cyan-500">●</span> {t('services.commerce.feature3')}</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="px-4 sm:px-6 lg:px-8 mt-24">
      <div class="bg-primary text-white p-12 md:p-16 text-center relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-primary via-primary/80 to-cyan-500 opacity-90 pointer-events-none"></div>
        <div class="relative z-10">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">
            {t('services.cta.title')}
          </h2>
          <p class="text-lg text-white/80 mb-8 max-w-xl mx-auto">
            {t('services.cta.subtitle')}
          </p>
          <a 
            href={`/${lang}/contact`}
            class="inline-block bg-white text-primary px-10 py-4 text-xs font-bold uppercase hover:bg-cyan-500 hover:text-white transition-colors"
          >
            {t('services.cta.button')}
          </a>
        </div>
      </div>
    </section>
  </main>
</DefaultLayout>