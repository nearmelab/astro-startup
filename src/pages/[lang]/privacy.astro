---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { useTranslations } from '@/i18n/utils';
import { ui } from '@/i18n/ui';

export function getStaticPaths() {
  return Object.keys(ui).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const t = useTranslations(lang);
---

<DefaultLayout
    meta_title={t('privacy_page.meta_title')}
    meta_description={t('privacy_page.meta_description')}
    dir={lang === 'ar' ? 'rtl' : 'ltr'}
>
    <div class="pt-32 pb-20 max-w-3xl mx-auto px-4">
        <h1 class="text-4xl font-bold mb-8">{t('privacy_page.title')}</h1>
        <div 
            class="prose prose-slate dark:prose-invert max-w-none space-y-6 text-slate-600 dark:text-slate-400 leading-relaxed"
            set:html={t('privacy_page.content')} 
        />
    </div>
</DefaultLayout>
